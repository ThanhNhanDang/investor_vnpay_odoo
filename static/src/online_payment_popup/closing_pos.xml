<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        <xpath expr="//div[@class='d-flex gap-2']" position="inside">
            <button class="button highlight btn btn-primary"  t-on-click="checkInventory" t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'">Kiểm kê tồn kho</button>
            <button class="button highlight btn btn-primary"  t-on-click="checkDevice" t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'">Kiểm kê thiết bị</button>
        </xpath>
    </t>
</templates>