<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

 <t t-name="inherit_point_of_sale.Numpad" t-inherit="point_of_sale.Numpad" t-inherit-mode="extension">
 <xpath expr="//div" position="replace">
    <div t-attf-class="d-grid numpad numpad-4-cols m-n1 {{props.class}}">
      <t t-foreach="buttons.map((b) => typeof b === 'object' ? b : { value: b })"  t-as="button" t-key="button.value">
        <span t-if="Object.keys(button).length === 0"/>
        <button 
            t-else=""
            t-attf-class="numpad-button btn btn-light lh-lg m-1{{ button.class or '' }} {{button.value == 'pricelist' ?'fs-4':'fs-3 btn-lg'}}"
            t-on-click="() => this.onClick(button.value)"
            t-att-disabled="button.disabled">
              <t t-if="button.value == 'pricelist'">
                <i class="fa fa-th-list me-1" role="img" aria-label="Icon" title="Icon"/>
                  <t t-if="currentOrder?.pricelist_id" t-esc="currentOrder.pricelist_id.name" />
                  <t t-else="">
                    <t t-esc="button.text or button.value"/>
                  </t>
                </t>
              <t t-else="">
                <t t-esc="button.text or button.value"/>
              </t>
        </button>
      </t>
    </div>
 </xpath>
  </t>
</templates>