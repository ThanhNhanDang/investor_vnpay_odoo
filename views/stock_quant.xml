<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherit_view_stock_quant_tree_inventory_editable" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.editable.inherit.is_device</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="is_device_work" optional="hide" />
                <field name="note_device" optional="hide" />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="custom_view_stock_quant_tree_inventory_editable">
        <field name="name">custom.stock.quant.inventory.list.editable</field>
        <field name="model">stock.quant</field>
        <field eval="10" name="priority" />
        <field name="arch" type="xml">
            <list
                default_order="location_id, inventory_date, product_id, package_id, lot_id, owner_id"
                decoration-warning='is_outdated' editable="bottom" create="0" edit="1" import="1"
                js_class="inventory_report_list" sample="1">
                <header>
                    <button name="action_apply_all_custom" string="Apply All" type="object"
                        class="btn btn-secondary"
                        invisible="not context.get('inventory_mode') or context.get('inventory_report_mode')"
                        display="always"
                    />
                </header>
                <field name="create_date" column_invisible="True" />
                <field name="write_date" column_invisible="True" />
                <field name="id" column_invisible="True" />
                <field name="is_outdated" column_invisible="True" />
                <field name="sn_duplicated" column_invisible="True" />
                <field name="tracking" column_invisible="True" />
                <field name="inventory_quantity_set" column_invisible="True" />
                <field name="company_id" column_invisible="True" />
                <field name="location_id" domain="[('usage', 'in', ['internal', 'transit'])]"
                    column_invisible="context.get('hide_location', False)" readonly="id"
                    options="{'no_create': True}" />
                <field name="storage_category_id" groups="stock.group_stock_multi_locations"
                    column_invisible="context.get('hide_location', False)"
                    options="{'no_create': True}" optional="hidden" />
                <field name="cyclic_inventory_frequency"
                    column_invisible="context.get('hide_location', False)"
                    options="{'no_create': True}" optional="hidden" />
                <field name="is_favorite" column_invisible="True" widget="boolean_favorite"
                    nolabel="1" optional="hidden" />
                <field name="product_id" readonly="context.get('single_product', False) or id"
                    force_save="1" options="{'no_create': True}" />
                <field name="product_categ_id" column_invisible="True" optional="hide" />
                <button name="action_warning_duplicated_sn" type="object"
                    invisible="not sn_duplicated"
                    title="This lot/serial number is already in another location"
                    class="btn btn-secondary text-warning float-end" icon="fa-warning" />
                <field name="lot_id" groups="stock.group_production_lot"
                    column_invisible="True"
                    readonly="tracking not in ['serial', 'lot'] or (id and (lot_id or quantity != 0))"
                    context="{'default_product_id': product_id}"
                    decoration-warning="sn_duplicated"
                    force_save="1" />
                <field name="package_id" column_invisible="True" groups="stock.group_tracking_lot"
                    readonly="id" />
                <field name="owner_id" column_invisible="True" groups="stock.group_tracking_owner"
                    readonly="id"
                    options="{'no_create': True}" />
                <field name="last_count_date" column_invisible="True" optional='hidden' readonly='1' />
                <field name="available_quantity" column_invisible="True" string="Available Quantity"
                    decoration-danger="available_quantity &lt; 0" optional="hidden" />
                <field name="quantity" column_invisible="True" optional="show"
                    decoration-warning="quantity &lt; 0"
                    string="On Hand Quantity" />
                <field name="product_uom_id" column_invisible="True" groups="uom.group_uom"
                    string="UoM" />
                <field name="is_device_work" column_invisible="not context.get('is_device')" />
                <field name="note_device" column_invisible="not context.get('is_device')" />
                <field name="inventory_quantity" widget="counted_quantity_widget"/>
                <field name="inventory_diff_quantity" column_invisible="True" string="Difference"
                    invisible="not inventory_quantity_set"
                    decoration-muted="inventory_diff_quantity == 0"
                    decoration-danger="inventory_diff_quantity &lt; 0"
                    decoration-success="inventory_diff_quantity &gt; 0"
                    decoration-bf="inventory_diff_quantity != 0" />
                <field name="inventory_date" column_invisible="True" optional="show" />
                <field name="user_id" column_invisible="True" string="User" optional="show" />
                <field name='company_id' column_invisible="True" groups="base.group_multi_company"
                    optional="hide" />
                <field name="lot_properties" column_invisible="True" optional="hide" />
            </list>
        </field>
    </record>
</odoo>